/source_material/Magus_UTK_v1.pdf
/source_material/pages/
/source_material/pilot_md/
/source_material/crop_test/
/source_material/build/deskewed/
/source_material/build/strips/
/source_material/build/crops/
/source_material/build/prep_full.log
/source_material/build/md/
/source_material/build/ocr/
/source_material/build/chapters/
/src/book/*.md
!/src/book/README.md

# local certificates
/local-cert/

# Python bytecode (docs/brand/build_icons.py)
__pycache__/

