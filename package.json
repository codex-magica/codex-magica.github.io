{
  "name": "codex-magica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Digital compendium and character sheet for the Hungarian M.A.G.U.S. tabletop RPG (Új Törvénykönyv), built from a scanned 514-page rulebook.",
  "author": "Márton Dániel (https://github.com/marcigo36)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcigo36/codex-magica.git"
  },
  "keywords": [
    "magus",
    "ttrpg",
    "rpg",
    "character-sheet",
    "compendium",
    "react",
    "typescript",
    "ocr"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src vite.config.ts"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
